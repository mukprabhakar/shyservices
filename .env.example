# Shivyam Management Services Private Limited - Environment Variables Template
# Copy this file to .env and configure with your Supabase credentials:
# cp .env.example .env

# Supabase API Settings (Obtain from: Supabase Dashboard > Project Settings > API)
# DO NOT COMMIT THE REAL .env FILE OR ANY SERVICE ROLE KEYS TO GIT.

# Project Reference ID (e.g. abcdefghijklmnopqrst)
SUPABASE_PROJECT_ID="your_supabase_project_id"
VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"

# Project URL (e.g. https://abcdefghijklmnopqrst.supabase.co)
SUPABASE_URL="https://your_supabase_project_id.supabase.co"
VITE_SUPABASE_URL="https://your_supabase_project_id.supabase.co"

# Public Publishable Key (starts with sb_publishable_ or eyJ...)
SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"
